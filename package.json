{
	"name": "@vafast/jwt",
	"version": "0.1.1",
	"description": "Plugin for Vafast for JWT authentication",
	"type": "module",
	"license": "MIT",
	"scripts": {
		"build": "tsdown",
		"dev": "npx tsx watch example/index.ts",
		"test": "npx vitest run",
		"prepublishOnly": "npm run build",
		"release": "npm run build && npm run test && npx bumpp && npm publish --access=public"
	},
	"main": "./dist/index.mjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs",
			"default": "./dist/index.mjs"
		}
	},
	"keywords": [
		"vafast",
		"jwt",
		"authentication"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/vafast/vafast-jwt"
	},
	"author": {
		"name": "saltyAom",
		"url": "https://github.com/SaltyAom",
		"email": "saltyaom@gmail.com"
	},
	"homepage": "https://github.com/vafast/vafast-jwt",
	"bugs": "https://github.com/vafast/vafast-jwt/issues",
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"peerDependencies": {
		"@sinclair/typebox": "^0.34.39",
		"vafast": "<2.0.0"
	},
	"dependencies": {
		"jose": "^5.0.0"
	},
	"devDependencies": {
		"@sinclair/typebox": "^0.34.39",
		"@types/node": "^24.0.0",
		"rimraf": "^6.0.1",
		"tsdown": "^0.19.0-beta.4",
		"typescript": "^5.4.5",
		"vafast": "^0.8.3",
		"vitest": "^4.0.16"
	}
}
